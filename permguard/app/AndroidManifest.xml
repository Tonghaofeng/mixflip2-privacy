<?xml version="1.0" encoding="utf-8"?>
<!-- permguard：经 Shizuku（shell 身份）定时跑 core 规则引擎。无界面依赖：定时任务 + 开机 + Shizuku 就绪时自动执行。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="uk.tonytong.permguard"
    android:versionCode="20261003"
    android:versionName="2026.10.03">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".App"
        android:label="PermGuard"
        android:icon="@android:drawable/ic_lock_lock"
        android:allowBackup="false">

        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GuardJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 受保护广播，只有系统发得出 -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 服务端通过它把 binder 交给本 App（服务端启动时会调用，顺带拉起进程） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="uk.tonytong.permguard.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
